# Server
PORT=3000

# Optional shared secret required on incoming webhooks (X-Webhook-Secret header)
WEBHOOK_SECRET=

# --- SMS notifications (Twilio) ---
# Leave blank to disable SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_PHONE_NUMBER=

# --- Push notifications (ntfy.sh, no account needed) ---
# Pick any unique topic name at https://ntfy.sh/<topic> and subscribe to it
# in the ntfy app. Leave blank to disable push notifications.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
